generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(uuid())
  email String? @unique
  phone String? @unique
  platformAdmin Boolean @default(false)
  name String
  passwordHash String
  role String @default("editor")
  active Boolean @default(true)
  createdAt DateTime @default(now())
  sessions Session[]
  keys ApiKey[]
}
model Session {
  teamId String @default("legacy-team")
  id String @id @default(uuid())
  hash String @unique
  userId String
  user User @relation(fields: [userId], references: [id])
  expiresAt DateTime
}
model ApiKey {
  teamId String @default("legacy-team")
  @@index([teamId])
  id String @id @default(uuid())
  name String
  note String @default("")
  prefix String
  hash String @unique
  ciphertext String
  ownerId String
  owner User @relation(fields: [ownerId], references: [id])
  scopes String[]
  productIds String[]
  enabled Boolean @default(true)
  expiresAt DateTime?
  revokedAt DateTime?
  lastUsedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Resource {
  teamId String @default("legacy-team")
  @@index([teamId])
  id String @id @default(uuid())
  kind String
  title String
  productId String?
  planId String?
  parentId String?
  uniqueSlot String? @unique
  status String @default("draft")
  version Int @default(1)
  content Json
  createdBy String
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revisions Revision[]
  @@index([kind, productId, planId])
}
model Revision {
  teamId String @default("legacy-team")
  @@index([teamId])
  id String @id @default(uuid())
  resourceId String
  resource Resource @relation(fields: [resourceId], references: [id])
  version Int
  title String
  status String
  content Json
  sources Json
  actorId String
  actorType String
  createdAt DateTime @default(now())
  @@unique([resourceId, version])
}
model Channel {
  id String @id @default(uuid())
  name String
  provider String
  baseUrl String
  ciphertext String
  enabled Boolean @default(true)
  concurrency Int @default(3)
  models Json
  options Json @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model ProductionBatch {
  teamId String @default("legacy-team")
  @@index([teamId])
  id String @id @default(uuid())
  title String
  productId String
  planId String?
  kind String
  version Int @default(1)
  snapshot Json
  digest String
  status String
  createdBy String
  approvedBy String?
  approvedAt DateTime?
  approvedDigest String?
  createdAt DateTime @default(now())
  jobs Job[]
}
model Job {
  conversationId String?
  teamId String @default("legacy-team")
  @@index([teamId])
  id String @id @default(uuid())
  batchId String?
  batch ProductionBatch? @relation(fields: [batchId], references: [id])
  productId String?
  planId String?
  kind String
  status String @default("queued")
  phase String @default("submit")
  channelId String?
  input Json
  upstreamId String?
  providerPath String?
  actualChannel String?
  result Json?
  error String?
  cancelRequested Boolean @default(false)
  leaseUntil DateTime?
  leaseOwner String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, updatedAt])
  @@index([conversationId])
}
model Outbox {
  id String @id @default(uuid())
  jobId String
  phase String
  availableAt DateTime @default(now())
  deliveredAt DateTime?
  createdAt DateTime @default(now())
  @@index([deliveredAt, availableAt])
}
model FileObject {
  teamId String @default("legacy-team")
  @@index([teamId])
  id String @id @default(uuid())
  productId String?
  conversationId String?
  sourceFileId String?
  name String
  key String @unique
  mime String
  bytes Int
  sha256 String?
  status String @default("pending")
  parseStatus String @default("pending")
  extractedText String?
  parseError String?
  metadata Json?
  createdBy String
  createdAt DateTime @default(now())
  @@index([productId])
  @@index([conversationId])
}
model AuditEvent {
  teamId String @default("legacy-team")
  @@index([teamId])
  id String @id @default(uuid())
  actorId String
  actorType String
  action String
  entityId String?
  productId String?
  data Json
  createdAt DateTime @default(now())
  @@index([productId, createdAt])
}
model Idempotency {
  teamId String @default("legacy-team")
  @@index([teamId])
  id String @id @default(uuid())
  actorId String
  key String
  requestHash String
  response Json?
  createdAt DateTime @default(now())
  @@unique([teamId, actorId, key])
}
model Conversation {
  teamId String @default("legacy-team")
  @@index([teamId])
  id String @id @default(uuid())
  title String
  ownerId String
  productId String?
  planId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages Message[]
  runs AgentRun[]
}
model Message {
  attachmentIds String[] @default([])
  runId String?
  status String @default("completed")
  teamId String @default("legacy-team")
  @@index([teamId])
  id String @id @default(uuid())
  conversationId String
  conversation Conversation @relation(fields: [conversationId], references: [id])
  role String
  text String
  createdAt DateTime @default(now())
}
model AgentRun {
  attempt Int @default(0)
  attachmentIds String[] @default([])
  inputJobIds String[] @default([])
  searchCount Int @default(0)
  teamId String @default("legacy-team")
  @@index([teamId])
  id String @id @default(uuid())
  conversationId String
  conversation Conversation @relation(fields: [conversationId], references: [id])
  ownerId String
  sourceKeyId String?
  status String @default("queued")
  prompt String
  tokenHash String @unique
  tokenCiphertext String
  scopes String[]
  productIds String[]
  stopRequested Boolean @default(false)
  leaseUntil DateTime?
  result String?
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgentEvent {
  teamId String @default("legacy-team")
  @@index([teamId])
  seq BigInt @id @default(autoincrement())
  conversationId String
  runId String?
  eventKey String @unique
  type String
  data Json
  createdAt DateTime @default(now())
  @@index([conversationId, seq])
}
model FileAnalysis {
  teamId String @default("legacy-team")
  @@index([teamId])
  id String @id @default(uuid())
  fileId String
  fingerprint String @unique
  jobId String @unique
  model String
  prompt String
  promptVersion String @default("video-v1")
  status String @default("queued")
  result Json?
  rawResponse Json?
  usage Json?
  error String?
  providerFileId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([fileId, createdAt])
}
model SearchRecord {
  teamId String @default("legacy-team")
  @@index([teamId])
  id String @id @default(uuid())
  actorId String
  runId String?
  conversationId String?
  requestKey String @unique
  query String
  status String @default("running")
  result Json?
  createdAt DateTime @default(now())
}
model Team {
 id String @id @default(uuid())
 name String
 archived Boolean @default(false)
 createdBy String
 createdAt DateTime @default(now())
}
model TeamMember {
 id String @id @default(uuid())
 teamId String
 userId String
 role String @default("editor")
 active Boolean @default(true)
 createdAt DateTime @default(now())
 @@unique([teamId, userId])
 @@index([userId])
}
model TeamInvitation {
 id String @id @default(uuid())
 teamId String
 phone String
 role String @default("editor")
 hash String @unique
 createdBy String
 expiresAt DateTime
 acceptedAt DateTime?
 revokedAt DateTime?
 createdAt DateTime @default(now())
 @@index([teamId])
}
model SmsChallenge {
 id String @id @default(uuid())
 phone String
 purpose String
 hash String
 attempts Int @default(0)
 expiresAt DateTime
 consumedAt DateTime?
 status String @default("sending")
 ipHash String
 userId String?
 createdAt DateTime @default(now())
 @@index([phone, purpose, createdAt])
 @@index([ipHash, createdAt])
}
model Wallet {
 id String @id @default(uuid())
 teamId String @unique
 balance Decimal @default(0) @db.Decimal(20,6)
 frozen Decimal @default(0) @db.Decimal(20,6)
 updatedAt DateTime @updatedAt
}
model CreditLedger {
 id String @id @default(uuid())
 teamId String
 eventKey String @unique
 actorId String
 kind String
 amount Decimal @db.Decimal(20,6)
 reason String
 referenceId String?
 createdAt DateTime @default(now())
 @@index([teamId, createdAt])
}
model PurchaseRate {
 billingSchedule Json @default("{}")
 sourceType String @default("verified")
 sourceUrl String?
 checkedAt DateTime?
  pricingParameters Json @default("{}")
 id String @id @default(uuid())
 channelId String
 model String
 kind String
 version Int
 unit String
 rate Decimal @db.Decimal(20,8)
 inputRate Decimal? @db.Decimal(20,8)
 cachedInputRate Decimal? @db.Decimal(20,8)
 resolution String @default("")
 supplier String @default("")
 basis String
 effectiveAt DateTime @default(now())
 createdBy String
 createdAt DateTime @default(now())
 @@unique([channelId, model, resolution, supplier, version])
}
model CreditQuote {
 id String @id @default(uuid())
 teamId String
 actorId String
 digest String
 input Json
 lines Json
 amount Decimal @db.Decimal(20,6)
 expiresAt DateTime
 usedBy String? @unique
 createdAt DateTime @default(now())
 @@index([teamId])
}
model UsageRecord {
 payerKind String @default("team")
 payerUserId String?
 id String @id @default(uuid())
 teamId String
 invocationId String @unique
 actorId String
 kind String
 model String
 channelId String
 rateId String
 quoteLine Json
 requestHash String
 reserved Decimal @db.Decimal(20,6)
 charged Decimal? @db.Decimal(20,6)
 costCny Decimal? @db.Decimal(20,8)
 status String @default("reserved")
 costType String @default("unknown")
 upstreamId String?
 actualSupplier String?
 data Json?
 response Json?
 error String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([teamId, createdAt])
}

model UserWallet {
 id String @id @default(uuid())
 userId String @unique
 balance Decimal @default(0) @db.Decimal(20,6)
 frozen Decimal @default(0) @db.Decimal(20,6)
 updatedAt DateTime @updatedAt
}

model PersonalCreditLedger {
 id String @id @default(uuid())
 userId String
 sourceTeamId String?
 eventKey String @unique
 actorId String
 kind String
 amount Decimal @db.Decimal(20,6)
 reason String
 referenceId String?
 createdAt DateTime @default(now())
 @@index([userId, createdAt])
}

model PlatformSetting {
 id String @id @default("main")
 fallbackCny Decimal @default(1) @db.Decimal(20,8)
 updatedBy String?
 updatedAt DateTime @updatedAt
}
