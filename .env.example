# Frameflow Film：产品描述 → 成片的独立 n8n 流水线（助手工具 start_film_pipeline）
FILM_ORDER_URL=https://n8n.sligenai.cn/webhook/frameflow-film/v1/order
FILM_STATUS_URL=https://n8n.sligenai.cn/webhook/frameflow-film/v1/status
FILM_APPROVE_URL=https://n8n.sligenai.cn/webhook/frameflow-film/v1/approve
# 与 n8n 凭据「Frameflow Film · 开单令牌」里的 X-Film-Token 一致（服务端专用，勿进仓库）
FILM_ORDER_TOKEN=
# 审批魔法链接的 HMAC 密钥，必须与 n8n 工作流里的 FILM_SIGNING_SECRET 完全一致
FILM_SIGNING_SECRET=
