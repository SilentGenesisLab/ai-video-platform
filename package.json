{
  "name": "ai-video-platform",
  "version": "1.4.4",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "worker": "tsx --env-file=.env src/worker/index.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "tsx --env-file=.env tests/integration.ts",
    "skill:build": "tsx scripts/build-skill.ts",
    "test:recovery": "tsx --env-file=.env tests/recovery.ts",
    "test:browser": "playwright test",
    "format": "prettier --write src tests scripts agent/*.md docs public/skills/ai-video-platform README.md",
    "test:teams": "tsx --env-file=.env tests/teams-integration.ts && tsx --env-file=.env tests/metering-integration.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "ali-oss": "^6.23.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.61.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.2",
    "ioredis": "^5.8.1",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.10.0",
    "next": "^16.0.0",
    "pdf-parse": "^1.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.4",
    "undici": "^8.11.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/ali-oss": "^6.23.3",
    "@types/node": "^22.18.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
